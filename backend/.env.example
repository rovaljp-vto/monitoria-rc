# ─────────────────────────────────────────────────────────────────────────────
# Monitoria de Qualidade — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# ─────────────────────────────────────────────────────────────────────────────

# Banco (PostgreSQL do servidor — ver INSTALACAO.md, etapa 2)
DATABASE_URL="postgresql://monitoria:TROQUE_A_SENHA@localhost:5432/monitoria_qualidade?schema=public"

# Porta da aplicação.
# ⚠️ Frontend, /api/sync/*, /sso/login saem TODOS desta porta: o RovalConnecta
# deriva o endereço do SSO de <origin-do-syncUrl>/sso/login (GUIA-SSO.md).
# No servidor SVR-RCJP: 3000 hub · 3001 nr1 · 3002 fac · 3003 pop · 3004 escuta
# · 3005 mensagens · 3006 dash-financeiro · 3007 chamados-ti; 3008 = este sistema.
PORT=3008

# Segredo HMAC compartilhado com o RovalConnecta — o MESMO valor do campo
# "Segredo HMAC" em Gestão de Sistemas → Monitoria de Qualidade.
# Usado no webhook /api/sync/users, no catálogo /api/sync/permissions e no SSO.
ROVAL_SYNC_SECRET=

# UUID do SystemModule no RovalConnecta. Preenchido, o SSO recusa tokens
# emitidos para outro módulo. Recomendado em produção.
ROVAL_MODULE_ID=

# development | production
NODE_ENV=production

# Endereço do RovalConnecta — destino do botão "Ir para o RovalConnecta" na
# tela de quem chega sem sessão. Trocar aqui não exige novo build.
ROVAL_CONNECTA_URL=http://192.168.1.4:3000

# Sessão
SESSION_COOKIE_NAME=monitoria_sid
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Em produção o cookie exige HTTPS (Secure) por padrão — e a CSP ganha
# upgrade-insecure-requests, que faz o navegador buscar tudo em HTTPS (tela
# preta se o servidor só fala HTTP). Se o servidor atende só em HTTP dentro da
# rede interna, assuma a escolha explicitamente com as DUAS linhas:
# SESSION_COOKIE_SECURE=false
# PERMITIR_SESSAO_SEM_HTTPS=true

# Fuso de exibição e de "mês de referência" da cobertura. Datas gravadas em UTC.
TIMEZONE=America/Sao_Paulo

# Porta de demonstração em /entrar (entra como um usuário do banco sem o hub,
# assinando um token SSO local). IGNORADA quando NODE_ENV=production.
DEMO_LOGIN=false
